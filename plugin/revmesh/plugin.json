{
  "id": "revmesh",
  "name": "revmesh",
  "version": "0.3.0",
  "description": "Opens STL, OBJ and PLY meshes as editable designs: recognises plates, holes and fillets and rebuilds them as a parametric history; anything not recognised is kept as a mesh. Project: https://github.com/stritti/revmesh",
  "updates": {
    "github": "stritti/revmesh"
  },
  "capabilities": [
    "formats@0.2",
    "evaluate@0.2"
  ],
  "runtime": {
    "module": "revmesh.wasm",
    "commands": [],
    "entries": [
      {
        "name": "stl",
        "kind": "importer",
        "extensions": [
          "stl",
          "obj",
          "ply"
        ],
        "slots": [
          {
            "kind": "ribbon",
            "name": "Insert"
          }
        ],
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/stl.svg",
          "properties": {
            "units": {
              "type": "string",
              "title": "Units",
              "enum": [
                "mm",
                "inch"
              ],
              "default": "mm",
              "description": "Mesh files are unitless and assumed to be mm; inch: the file is read as inches and converted to millimetres"
            }
          }
        }
      }
    ],
    "limits": {
      "fuel": 100000000000,
      "memory_mib": 128,
      "deadline_ms": 120000
    }
  }
}
